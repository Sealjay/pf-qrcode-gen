{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/.well-known/*", "allowedRoles": ["anonymous"] },
    {
      "route": "/.auth/login/aad",
      "statusCode": 404
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/login",
      "rewrite": "/.auth/login/github"
    },
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "must-revalidate, max-age=15770000"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": [
      "/images/*.{png,jpg,gif}",
      "/css/*",
      "/favicon.ico",
      "/.well-known/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "index.html",
      "statusCode": 404
    },
    "401": {
      "redirect": "/login",
      "statusCode": 302
    }
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
