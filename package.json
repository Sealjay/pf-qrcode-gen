{
  "name": "swa-pfqrcodegen",
  "private": true,
  "version": "0.0.0",
  "description": "A React app that generates a dynamic QR code for club pass access",
  "type": "module",
  "license": "MIT",
  "author": "Chris Lloyd-Jones",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealjay/pf-qrcode-gen"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "dependencies": {
    "preact": "^10.29.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@biomejs/biome": "^2.5.2",
    "@preact/preset-vite": "^2.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
