{
  "name": "swa-pfqrcodegen",
  "private": true,
  "version": "0.0.0",
  "description": "A React app that generates a dynamic QR code for club pass access",
  "type": "module",
  "license": "MIT",
  "author": "Chris Lloyd-Jones",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealjay/pf-qrcode-gen"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
